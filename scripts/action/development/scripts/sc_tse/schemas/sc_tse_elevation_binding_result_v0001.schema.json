{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc_tse_elevation_binding_result_v0001.schema.json",
  "title": "SC-TSE Elevation Binding Result v0001",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "execution_status",
    "problem_id",
    "problem_hash",
    "source_import",
    "bindings",
    "summary",
    "selection_policy_version",
    "config_hash",
    "scope",
    "observability"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "sc-tse-elevation-binding-result-v0.1.0"},
    "record_type": {"const": "ElevationBindingRun"},
    "execution_status": {"const": "COMPLETED"},
    "problem_id": {"type": "string", "minLength": 1},
    "problem_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_import": {"type": "object"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "binding_id", "request_id", "geometry_ref", "semantic", "reference", "geometry_source",
          "status", "value_m", "value_classification", "selected_evidence_id",
          "supporting_evidence_ids", "elevation_sources", "surface_eligible", "diagnostic"
        ],
        "additionalProperties": false,
        "properties": {
          "binding_id": {"type": "string", "pattern": "^elevation-binding-[a-f0-9]{24}$"},
          "request_id": {"type": "string", "minLength": 1},
          "geometry_ref": {"type": "string", "minLength": 1},
          "semantic": {"type": "string", "minLength": 1},
          "reference": {"type": "string", "minLength": 1},
          "geometry_source": {"type": "object"},
          "status": {"enum": ["BOUND", "AMBIGUOUS_ELEVATION_BINDING", "UNAVAILABLE_ELEVATION_BINDING"]},
          "value_m": {"type": ["number", "null"]},
          "value_classification": {"type": ["string", "null"]},
          "selected_evidence_id": {"type": ["string", "null"]},
          "supporting_evidence_ids": {"type": "array"},
          "elevation_sources": {"type": "array"},
          "surface_eligible": {"type": "boolean"},
          "diagnostic": {"type": ["string", "null"]}
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["binding_count", "bound_count", "ambiguous_count", "unavailable_count"],
      "additionalProperties": false,
      "properties": {
        "binding_count": {"type": "integer", "minimum": 0},
        "bound_count": {"type": "integer", "minimum": 0},
        "ambiguous_count": {"type": "integer", "minimum": 0},
        "unavailable_count": {"type": "integer", "minimum": 0}
      }
    },
    "selection_policy_version": {"const": "v0001"},
    "config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scope": {"const": "ELEVATION_BINDING_ONLY_NO_SURFACE_INTERPOLATION"},
    "observability": {
      "type": "object",
      "required": ["total_ms", "binding_count"],
      "additionalProperties": false,
      "properties": {
        "total_ms": {"type": "number", "minimum": 0},
        "binding_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
