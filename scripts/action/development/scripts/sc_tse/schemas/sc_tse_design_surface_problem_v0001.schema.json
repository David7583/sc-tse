{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc_tse_design_surface_problem_v0001.schema.json",
  "title": "SC-TSE Design Surface Problem v0001",
  "type": "object",
  "required": ["schema_version", "record_type", "problem_id", "coordinate_frame", "source_package_sha256", "surfaces", "problem_hash"],
  "properties": {
    "schema_version": {"const": "sc-tse-design-surface-problem-v0.1.0"},
    "record_type": {"const": "DesignSurfaceProblem"},
    "problem_id": {"type": "string", "minLength": 1},
    "coordinate_frame": {"type": "object"},
    "source_package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "surfaces": {"type": "array", "minItems": 1},
    "problem_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
