{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc_tse_elevation_binding_problem_v0001.schema.json",
  "title": "SC-TSE Elevation Binding Problem v0001",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "problem_id",
    "source_import",
    "coordinate_frame",
    "geometry_objects",
    "elevation_evidence",
    "binding_requests",
    "problem_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "sc-tse-elevation-binding-problem-v0.1.0"},
    "record_type": {"const": "ElevationBindingProblem"},
    "problem_id": {"type": "string", "minLength": 1},
    "source_import": {"type": "object"},
    "coordinate_frame": {"type": "object"},
    "geometry_objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["geometry_ref", "geometry", "geometry_hash", "geometry_source"],
        "additionalProperties": false,
        "properties": {
          "geometry_ref": {"type": "string", "minLength": 1},
          "geometry": {"type": "object"},
          "geometry_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "geometry_source": {"type": "object"}
        }
      }
    },
    "elevation_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id", "geometry_ref", "semantic", "value_m", "reference", "mode",
          "declared_value_source", "elevation_source_ref", "surface_eligible"
        ],
        "additionalProperties": false,
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "geometry_ref": {"type": "string", "minLength": 1},
          "semantic": {"type": "string", "minLength": 1},
          "value_m": {"type": "number"},
          "reference": {"type": "string", "minLength": 1},
          "mode": {"type": "string", "minLength": 1},
          "declared_value_source": {"type": "string", "minLength": 1},
          "elevation_source_ref": {"type": "string", "minLength": 1},
          "surface_eligible": {"type": "boolean"}
        }
      }
    },
    "binding_requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["request_id", "geometry_ref", "semantic", "reference"],
        "additionalProperties": false,
        "properties": {
          "request_id": {"type": "string", "minLength": 1},
          "geometry_ref": {"type": "string", "minLength": 1},
          "semantic": {"type": "string", "minLength": 1},
          "reference": {"type": "string", "minLength": 1}
        }
      }
    },
    "problem_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
