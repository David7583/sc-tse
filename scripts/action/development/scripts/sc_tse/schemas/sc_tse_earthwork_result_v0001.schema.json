{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc_tse_earthwork_result_v0001.schema.json",
  "title": "SC-TSE Earthwork Result v0001",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "execution_status", "evaluation_status", "problem_id", "problem_hash", "design_parameter", "site_area_m2", "cut_area_m2", "fill_area_m2", "zero_area_m2", "cut_volume_m3", "fill_volume_m3", "net_earthwork_m3", "max_cut_depth_m", "max_fill_depth_m", "zero_cut_fill_line", "surface_method", "calculation_resolution", "coverage_ratio", "evaluated_area_m2", "not_evaluated_area_m2", "coverage_diagnostics", "resolution_stability", "source_refs", "sign_convention", "scope", "result_hash", "observability"],
  "properties": {
    "schema_version": {"const": "sc-tse-earthwork-result-v0.1.0"},
    "record_type": {"const": "EarthworkRun"},
    "execution_status": {"const": "COMPLETED"},
    "evaluation_status": {"enum": ["COMPLETE", "PARTIAL", "NOT_EVALUATED"]},
    "problem_id": {"type": "string", "minLength": 1},
    "problem_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "design_parameter": {"type": "object"},
    "site_area_m2": {"type": "number", "exclusiveMinimum": 0},
    "cut_area_m2": {"type": "number", "minimum": 0},
    "fill_area_m2": {"type": "number", "minimum": 0},
    "zero_area_m2": {"type": "number", "minimum": 0},
    "cut_volume_m3": {"type": "number", "minimum": 0},
    "fill_volume_m3": {"type": "number", "minimum": 0},
    "net_earthwork_m3": {"type": "number"},
    "max_cut_depth_m": {"type": ["number", "null"], "minimum": 0},
    "max_fill_depth_m": {"type": ["number", "null"], "minimum": 0},
    "zero_cut_fill_line": {"type": "object"},
    "surface_method": {"type": "object"},
    "calculation_resolution": {"type": "object"},
    "coverage_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "evaluated_area_m2": {"type": "number", "minimum": 0},
    "not_evaluated_area_m2": {"type": "number", "minimum": 0},
    "coverage_diagnostics": {"type": "object"},
    "resolution_stability": {"type": "array"},
    "source_refs": {"type": "object"},
    "sign_convention": {"const": "net_earthwork_m3 = fill_volume_m3 - cut_volume_m3"},
    "scope": {"const": "RAW_CUT_FILL_WITHOUT_MATERIAL_OR_COST_FACTORS"},
    "result_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observability": {"type": "object"}
  }
}
