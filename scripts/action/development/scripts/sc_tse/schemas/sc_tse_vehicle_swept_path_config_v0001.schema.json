{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SC-TSE Vehicle Swept Path Config v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sampling", "geometry", "numerics", "supported_turning_models"],
  "properties": {
    "schema_version": {"const": "sc-tse-vehicle-swept-config-v0.1.0"},
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pose_step_m", "maximum_pose_count"],
      "properties": {
        "pose_step_m": {"type": "number", "exclusiveMinimum": 0},
        "maximum_pose_count": {"type": "integer", "minimum": 2}
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["road_buffer_quadrant_segments"],
      "properties": {"road_buffer_quadrant_segments": {"type": "integer", "minimum": 1}}
    },
    "numerics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linear_tolerance_m", "area_tolerance_m2"],
      "properties": {
        "linear_tolerance_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.1},
        "area_tolerance_m2": {"type": "number", "minimum": 0, "maximum": 0.1}
      }
    },
    "supported_turning_models": {
      "const": ["MAX_STEERING_ANGLE", "MINIMUM_REAR_AXLE_RADIUS"]
    }
  }
}
