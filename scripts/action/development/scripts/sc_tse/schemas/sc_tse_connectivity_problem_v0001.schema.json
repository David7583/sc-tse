{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc_tse_connectivity_problem_v0001.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "problem_id", "coordinate_frame", "site", "blocks", "connection_requirements", "obstacle_buffers", "solver_config"],
  "properties": {
    "schema_version": {"const": "sc-tse-connectivity-problem-v0.1.0"},
    "problem_id": {"type": "string", "minLength": 1},
    "coordinate_frame": {
      "type": "object", "additionalProperties": false,
      "required": ["frame_id", "handedness", "z_axis", "length_unit"],
      "properties": {
        "frame_id": {"const": "SC_TSE_CARTESIAN_RH"}, "handedness": {"const": "RIGHT"},
        "z_axis": {"const": "UP"}, "length_unit": {"const": "m"}
      }
    },
    "site": {"$ref": "#/$defs/site"},
    "blocks": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/block"}},
    "connection_requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/connection"}},
    "obstacle_buffers": {"type": "array", "items": {"$ref": "#/$defs/obstacleBuffer"}},
    "solver_config": {"$ref": "#/$defs/solverConfig"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "point": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false, "minItems": 2, "maxItems": 2},
    "polygon": {
      "type": "object", "additionalProperties": false, "required": ["type", "coordinates"],
      "properties": {"type": {"const": "polygon"}, "coordinates": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/point"}}}
    },
    "rectangle": {
      "type": "object", "additionalProperties": false, "required": ["type", "center", "width_m", "height_m"],
      "properties": {"type": {"const": "rectangle"}, "center": {"$ref": "#/$defs/point"}, "width_m": {"type": "number", "exclusiveMinimum": 0}, "height_m": {"type": "number", "exclusiveMinimum": 0}, "rotation_deg": {"type": "number"}}
    },
    "geometry": {"oneOf": [{"$ref": "#/$defs/polygon"}, {"$ref": "#/$defs/rectangle"}]},
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["gate_id", "position", "gate_type", "allowed_connections", "metadata"],
      "properties": {"gate_id": {"type": "string", "minLength": 1}, "position": {"$ref": "#/$defs/point"}, "gate_type": {"type": "string", "minLength": 1}, "allowed_connections": {"type": "array", "items": {"type": "string"}}, "metadata": {"type": "object"}}
    },
    "site": {"type": "object", "additionalProperties": false, "required": ["site_id", "geometry"], "properties": {"site_id": {"type": "string"}, "geometry": {"$ref": "#/$defs/polygon"}, "metadata": {"type": "object"}}},
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["block_id", "block_type", "geometry", "semantic_attributes", "connection_gates", "metadata"],
      "properties": {"block_id": {"type": "string", "minLength": 1}, "block_type": {"type": "string", "minLength": 1}, "geometry": {"$ref": "#/$defs/geometry"}, "semantic_attributes": {"type": "object"}, "connection_gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}}, "metadata": {"type": "object"}}
    },
    "connection": {
      "type": "object", "additionalProperties": false,
      "required": ["connection_id", "source_block", "source_gate", "target_block", "target_gate", "connection_type", "required", "attributes"],
      "properties": {"connection_id": {"type": "string", "minLength": 1}, "source_block": {"type": "string"}, "source_gate": {"type": "string"}, "target_block": {"type": "string"}, "target_gate": {"type": "string"}, "connection_type": {"type": "string"}, "required": {"type": "boolean"}, "attributes": {"type": "object"}}
    },
    "obstacleBuffer": {"type": "object", "additionalProperties": false, "required": ["block_id", "buffer_m"], "properties": {"block_id": {"type": "string"}, "buffer_m": {"type": "number", "minimum": 0}}},
    "solverConfig": {
      "type": "object", "additionalProperties": false,
      "required": ["path_strategy", "initial_probe_distance_m", "gateway_search_step_m", "max_gateway_distance_m", "grid_resolution_m", "max_grid_expansions"],
      "properties": {
        "path_strategy": {"const": "GRID_A_STAR_4_NEIGHBOR"},
        "initial_probe_distance_m": {"type": "number", "exclusiveMinimum": 0},
        "gateway_search_step_m": {"type": "number", "exclusiveMinimum": 0},
        "max_gateway_distance_m": {"type": "number", "exclusiveMinimum": 0},
        "grid_resolution_m": {"type": "number", "exclusiveMinimum": 0},
        "max_grid_expansions": {"type": "integer", "minimum": 1}
      }
    }
  }
}
