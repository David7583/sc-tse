{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc_tse_vertical_contract_config_v0001.schema.json",
  "title": "SC-TSE Vertical Contract Config v0001",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "contract_version",
    "supported_modes",
    "supported_scope_types",
    "reference_policies",
    "source_kind_precedence",
    "mode_precedence",
    "calculation_contexts",
    "numerics"
  ],
  "properties": {
    "config_version": {"const": "v0001"},
    "contract_version": {"const": "sc-tse-vertical-contract-v0.1.0"},
    "supported_modes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 5,
      "items": {"enum": ["FIXED", "DERIVED", "SAMPLED", "PROFILE", "SURFACE"]}
    },
    "supported_scope_types": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 5,
      "items": {"enum": ["POINT", "EDGE", "FACE", "OBJECT", "REGION"]}
    },
    "reference_policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "requires_datum_id"],
        "properties": {
          "reference": {"type": "string", "minLength": 1},
          "requires_datum_id": {"type": "boolean"}
        }
      }
    },
    "source_kind_precedence": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {"enum": ["DIRECT_SOURCE", "DERIVED", "INFERRED", "SYNTHETIC", "USER_SUPPLIED"]}
    },
    "mode_precedence": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 5,
      "items": {"enum": ["FIXED", "DERIVED", "SAMPLED", "PROFILE", "SURFACE"]}
    },
    "calculation_contexts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "numerics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equivalent_value_tolerance_m"],
      "properties": {
        "equivalent_value_tolerance_m": {"type": "number", "minimum": 0, "maximum": 0.001}
      }
    }
  }
}
